{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  },
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "plan",
  "plugin": [
//    "file:///usr/lib/opencode/plugins/opencode-notifier",
//    "opencode-snip@1.6.1"
  ],
  "permission": {
    "read": {
      "~/.config/opencode/*": "allow",
      "~/Documents/github_learn": "allow",
      "~/.local/share/opencode": "allow",
      "/tmp/**": "allow",
      "/home/hk/Downloads/focus-plasmoid/": "allow"
    },
    "edit": {
      "~/.config/opencode/*": "allow",
      "~/Documents/github_learn": "deny",
      "~/.local/share/opencode": "deny",
      "/tmp/**": "allow",
      "/home/hk/Downloads/focus-plasmoid/": "deny"
    },
    "external_directory": {
      "~/.config/opencode/*": "allow",
      "~/Documents/github_learn": "allow",
      "/tmp/**": "allow",
      "/home/hk/Downloads/focus-plasmoid/": "allow"
    },
    "lsp":"allow",
    "glob": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "artifact-use": {
      "type": "remote",
      "url": "https://artifacts.iofold.com/mcp",
      "enabled": false
    },
    "websearch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "enabled": false,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "tavily-mcp": {
    "type": "local",
      "command": ["npx", "-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "{env:TAVILY_API_KEY}",
        "DEFAULT_PARAMETERS": "{\"include_images\": true, \"max_results\": 15, \"search_depth\": \"advanced\"}"
      }
    },
    "alphaxiv": {
      "type": "remote",
      "url": "https://api.alphaxiv.org/mcp/v1",
      "enabled": false,
      "headers": {
        "ALPHAXIV_API_KEY": "{env:ALPHAXIV_API_KEY}"
      }
    }
  }
}
